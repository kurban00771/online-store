<section class="products_section">
    <div class="container">
        <ul class="tag__section">
            {{#each catData}}
            <li>
                <a href="/category?id={{this.id}}" class="tag__section-link">{{this.title}}</a>
            </li>
            {{/each}}
        </ul>

        <div class="tag__select-mob">
            <select class="custom-select tag__select" onchange="if(this.value) window.location.href=this.value">
                <option value="" disabled selected>Категории</option>
                {{#each catData}}
                    <option value="/category?id={{this.id}}">{{this.title}}</option>
                {{/each}}
            </select>
        </div>


