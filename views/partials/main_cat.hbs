<section class="main__section">
    <h1 class="main__h1">Категории</h1>
    <div class="main__set-block">
        <label class="main__set-label">
            <p class="main__set-text">Категории</p>
            <input type="text" class="main__set-input" id="input__cat" placeholder="Категории">
        </label>
        <label class="main__set-label">
            <p class="main__set-text">Фото категории</p>
            <input type="file" class="main__set-input" id="input__cat-photo">
