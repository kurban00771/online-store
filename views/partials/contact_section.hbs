<section class="contact-section">
    <div class="container">
        <div class="contact__top">
            <div class="contact__wrapper-left">
                <img src="/img/about/{{aboutData.img_bg}}" alt="" class="contact__right-img">
            </div>
            <div class="contact__wrapper-right">
                <h2 class="contact__wrapper-h2">Наши адреса:</h2>
                <p class="contact__wrapper-text">Кисловодск</p>
                <p class="contact__wrapper-text">{{aboutData.address1}}</p>
                <p class="contact__wrapper-text">{{aboutData.address2}}</p>
                {{!-- {{#each aboutData.address}}
                <p class="contact__wrapper-text">{{this}}</p>
                {{/each}} --}}
            </div>
        </div>
        <div class="contact__bottom">
            <div class="contact__bottom-left">
                <h2 class="contact__wrapper-h2">Приём заказов</h2>
                {{#each aboutData.phones}}
                <a href="tel:{{this.tel}}" class="contact__wrapper-text">{{this.view}}</a>
                {{/each}}
                <h2 class="contact__wrapper-h2">Заказ столиков</h2>
                {{#each aboutData.phones}}
                <a href="tel:{{this.tel}}" class="contact__wrapper-text">{{this.view}}</a>
                {{/each}}
            </div>
            <div class="contact__bottom-right">
                <img src="/img/about/{{aboutData.cont_img1}}" alt="" class="contact__bottom-img">
                <img src="/img/about/{{aboutData.cont_img2}}" alt="" class="contact__bottom-img">
                <img src="/img/about/{{aboutData.cont_img3}}" alt="" class="contact__bottom-img">
                <img src="/img/about/{{aboutData.cont_img4}}" alt="" class="contact__bottom-img">
            </div>
        </div>
    </div>
</section>

  {{!-- "address": [
    "Кисловодск",
    "ул. Есенина 65",
    "ул. Пушкина, д. 22"
  ], --}}