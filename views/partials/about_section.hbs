<section class="about">
    <div class="container">
        <div class="about__background">
            <h1 class="about__h1">О НАС</h1>
        </div>
    </div>
</section>
<section class="about__desc-section">
    <div class="container">
        <div class="about__desc-wrapper">
            <div class="about__left">
                <div class="about__h2">{{aboutData.title_top}}</div>
                <p class="about__desc-text">{{aboutData.desc}}</p>
            </div>
            <div class="about__right">
                <img src="/img/about/{{aboutData.about_img1}}" alt="Внутри заведения" class="about__desc-pic">
            </div>
        </div>
    </div>
</section>

<section class="working">
    <div class="working__wrapper">
        <h2 class="working__h2">Прием заказов</h2>
        <img src="/img/table.png" alt="" class="working__img">
        <p class="working__line"></p>
        <img src="/img/clock.png" alt="" class="working__img">
        <p class="working__text">c 9:00 до 21:30 ежедневно</p>
    </div>
</section>

<section class="history">
    <div class="container">
        <div class="history__wrapper">
            <div class="history__block-img">
                <img src="/img/about/{{aboutData.about_img2}}" alt="Внутри" class="history__img">
            </div>
            <div class="history__desc">
                <h2 class="history__h2">{{aboutData.about_title}}</h2>
                <p class="history__text">{{aboutData.about_desc}}</p>
            </div>
        </div>
    </div>
</section>



