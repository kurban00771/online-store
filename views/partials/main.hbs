<main class="main">
    <div class="container">
        <h1 class="main-name">Меню</h1>
        <div class="main__cart-wrapper">
            {{#each catData}}
            {{#if this.active}}
            <div class="main__cart">
                <a href="/category?id={{this.id}}" class="main__cart-link">
                    <img src="/img/categories/{{this.img}}" alt="" class="main__cart-img">
                    <h3 class="main__cart-name">{{this.title}}</h3>
                </a>
            </div>
            {{/if}}
            {{/each}}

