{{!-- <button id="open-btn">Открыть окно</button> --}}
<div id="modal-overlay" class="overlay">
    <div id="cat_modal" class="modal">
        <button id="close-btn" class="close">&times;</button>
        <input id="cat_name" type="text" class="modal__input" placeholder="Название">
        <input id="cat_image" type="file" class="modal__input">
        <input id="cat_active" type="checkbox" class="modal__input">
        <button id="cat__edit" class="modal__btn">Изменить</button>
        <span hidden id="cat_id"></span>
    </div>
</div>